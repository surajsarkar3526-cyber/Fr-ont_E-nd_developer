const readline = require("readline");

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

function CountString(str) {
    let count = 0;

    for (const i of str) {
        count++;
        console.log(i);
    }

    console.log("\nTotal Count Letter : " + count);
}

rl.question("Enter Your String : ", (input) => {
    CountString(input);
    rl.close();
});

